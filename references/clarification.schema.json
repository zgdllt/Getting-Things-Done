          "project": {"type": ["string", "null"]},
          "suggested_due": {"type": ["string", "null"]},
          "disposition": {"type": "string", "enum": ["actionable", "resolved", "needs_clarification"]},
          "explanation": {"type": "string"},
          "follow_up": {"type": ["string", "null"]}
